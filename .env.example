# Copy to secret.env (or export directly) — never commit real values.

# Optional: enables the Telegram bot bridge for note-by-text and reminders.
# Get a token from @BotFather in Telegram.
TELEGRAM_BOT_TOKEN=

# Recommended whenever a token is set: the only chat the bot accepts. Without it
# the bot locks to whichever chat messages it first. The server log shows the
# chat id of every rejected message.
TELEGRAM_ALLOWED_CHAT_ID=

# Optional overrides
# PORT=3113
# DATA_DIR=./data
# TELEGRAM_API_URL=https://api.telegram.org
